# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://legalflow:legalflow_dev@localhost:5432/legalflow?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256) ──────────────────────────────────────────────
ENCRYPTION_KEY=change_me_32_char_hex_key_here_00

# ── AWS S3 ────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=legalflow-documents-dev

# ── Anthropic Claude ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LegalFlow <no-reply@legalflow.app>"
