// LegalFlow Digital – Prisma Schema
// Based on TFG data model (Tercera_Entrega_V1.pdf)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum RolUsuario {
  ABOGADO
  CLIENTE
}

enum PlanUsuario {
  FREE
  PRO
  ENTERPRISE
}

enum EstadoExpediente {
  ABIERTO
  EN_CURSO
  PENDIENTE_CLIENTE
  ARCHIVADO
  CERRADO
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  PAGADA
  VENCIDA
  ANULADA
}

enum TipoDocumento {
  CONTRATO
  ESCRITO_JUDICIAL
  DICTAMEN
  PODER_NOTARIAL
  FACTURA_PDF
  OTRO
}

enum TipoConversacion {
  NAVEGACION
  JURISPRUDENCIA
}

enum TipoAuditLog {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  DOWNLOAD
}

enum RolDespacho {
  OWNER
  MIEMBRO
}

enum FrecuenciaGasto {
  MENSUAL
  TRIMESTRAL
  CUATRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoNotificacion {
  DOCUMENTO_SUBIDO     // cliente sube documento → abogado
  DOCUMENTO_COMPARTIDO // abogado sube documento visible → cliente
  FACTURA_EMITIDA      // factura emitida → cliente
  HITO_PROXIMO         // recordatorio de hito próximo
  FACTURA_POR_VENCER   // recordatorio: factura a punto de vencer
  FACTURA_VENCIDA      // recordatorio: factura vencida
}

// Tipologías de gasto deducible (conceptos del Libro registro de compras y gastos / IRPF)
enum CategoriaGasto {
  ALQUILER // Arrendamientos y cánones (oficina, renting)
  SUMINISTROS // Luz, agua, teléfono, internet
  MATERIAL_OFICINA // Material y consumibles de oficina
  SERVICIOS_PROFESIONALES // Gestoría, procuradores, peritos
  CUOTA_AUTONOMOS // Seguridad Social (RETA)
  COLEGIO_PROFESIONAL // Cuotas de colegios y asociaciones
  SEGUROS // RC profesional, salud
  SOFTWARE_SUSCRIPCIONES // Software y suscripciones
  FORMACION // Cursos y formación
  PUBLICIDAD // Publicidad y marketing
  MANUTENCION // Manutención y dietas (con límites)
  VEHICULO_DESPLAZAMIENTO // Vehículo, combustible, transporte
  GASTOS_FINANCIEROS // Comisiones e intereses
  TRIBUTOS // IAE, tasas y tributos deducibles
  AMORTIZACION // Amortización de inmovilizado
  OTROS
}

// ─── Usuario ────────────────────────────────────────────────────────────────

model Despacho {
  id        String      @id @default(uuid())
  nombre    String
  plan      PlanUsuario @default(FREE)
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  usuarios       Usuario[]
  clientes       Cliente[]
  expedientes    Expediente[]
  facturas       Factura[]
  documentos     Documento[]
  conversaciones Conversacion[]
  usageEvents    UsageEvent[]
  gastos         Gasto[]
  auditLogs      AuditLog[]
  notificaciones Notificacion[]

    // Fiscal config
  configuracionFiscal ConfiguracionFiscal?

  @@map("despachos")
}

model Usuario {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  nombre        String
  apellidos     String
  role          RolUsuario   @default(CLIENTE)
  plan          PlanUsuario  @default(FREE)
  active        Boolean      @default(true)
  emailVerified Boolean      @default(false) @map("email_verified")
  lastLoginAt   DateTime?    @map("last_login_at")
  despachoId    String?      @map("despacho_id")
  rolDespacho   RolDespacho? @default(OWNER) @map("rol_despacho")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  despacho        Despacho?      @relation(fields: [despachoId], references: [id])
  clientesCreados Cliente[]      @relation("ClienteCreadoPor")
  clientePropio   Cliente?       @relation("ClienteUsuario")
  expedientes     Expediente[]
  documentos      Documento[]
  facturas        Factura[]
  conversaciones  Conversacion[]
  auditLogs       AuditLog[]
  notificaciones Notificacion[]
  
  @@map("usuarios")
}

// ─── Cliente ─────────────────────────────────────────────────────────────────

model Cliente {
  id          String   @id @default(uuid())
  despachoId  String   @map("despacho_id")
  creadoPorId String   @map("creado_por_id")
  usuarioId   String?  @unique @map("usuario_id")
  nombre      String
  apellidos   String?
  email       String?
  telefono    String?
  nif         String?
  direccion   String?
  activo      Boolean  @default(true)
  empresa     Boolean  @default(false)
  notas       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  despacho    Despacho     @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  creadoPor   Usuario      @relation("ClienteCreadoPor", fields: [creadoPorId], references: [id])
  usuario     Usuario?     @relation("ClienteUsuario", fields: [usuarioId], references: [id])
  expedientes Expediente[]

  @@index([despachoId])
  @@map("clientes")
}

// ─── Expediente ───────────────────────────────────────────────────────────────

model Expediente {
  id            String           @id @default(uuid())
  despachoId    String           @map("despacho_id")
  creadoPorId   String           @map("creado_por_id")
  clienteId     String           @map("cliente_id")
  titulo        String
  descripcion   String?
  estado        EstadoExpediente @default(ABIERTO)
  fechaApertura DateTime         @default(now()) @map("fecha_apertura")
  fechaCierre   DateTime?        @map("fecha_cierre")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  despacho   Despacho    @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  creadoPor  Usuario     @relation(fields: [creadoPorId], references: [id])
  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  documentos Documento[]
  facturas   Factura[]
  suplidos   Suplido[]
  hitos      Hito[]
  notas      Nota[]

  @@index([clienteId, estado])
  @@map("expedientes")
}

model Hito {
  id           String   @id @default(uuid())
  expedienteId String   @map("expediente_id")
  titulo       String
  descripcion  String?
  fecha        DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId, fecha])
  @@map("hitos")
}

model Nota {
  id           String   @id @default(uuid())
  expedienteId String   @map("expediente_id")
  contenido    String
  createdAt    DateTime @default(now()) @map("created_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId])
  @@map("notas")
}

// ─── Documento ────────────────────────────────────────────────────────────────

model Documento {
  id           String        @id @default(uuid())
  despachoId   String        @map("despacho_id")
  creadoPorId  String        @map("creado_por_id")
  expedienteId String        @map("expediente_id")
  suplidoId    String?       @map("suplido_id")
  facturaId    String?       @map("factura_id")
  titulo       String
  descripcion  String
  tipo         TipoDocumento @default(OTRO)
  s3Key        String        @map("s3_key")
  cifrado      Boolean       @default(false)
  hashSha256   String?       @map("hash_sha256")
  s3Url        String?       @map("s3_url")
  sizeBytes    Int           @map("size_bytes")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  despacho   Despacho   @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  creadoPor  Usuario    @relation(fields: [creadoPorId], references: [id])
  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  suplido    Suplido?   @relation(fields: [suplidoId], references: [id])
  factura    Factura?

  @@index([expedienteId])
  @@map("documentos")
}

// ─── Factura ──────────────────────────────────────────────────────────────────

model Factura {
  id               String        @id @default(uuid())
  despachoId       String        @map("despacho_id")
  creadoPorId      String        @map("creado_por_id")
  expedienteId     String        @map("expediente_id")
  numero           String
  estado           EstadoFactura @default(BORRADOR)
  fechaEmision     DateTime      @map("fecha_emision")
  fechaVencimiento DateTime?     @map("fecha_vencimiento")
  baseImponible    Decimal       @map("base_imponible") @db.Decimal(12, 2)
  tipoIva          Decimal       @default(21) @map("tipo_iva") @db.Decimal(5, 2)
  cuotaIva         Decimal       @map("cuota_iva") @db.Decimal(12, 2)
  tipoIrpf         Decimal       @default(15) @map("tipo_irpf") @db.Decimal(5, 2)
  cuotaIrpf        Decimal       @map("cuota_irpf") @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  notas            String?
  documentoId      String?       @unique @map("documento_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  despacho   Despacho   @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  creadoPor  Usuario    @relation(fields: [creadoPorId], references: [id])
  expediente Expediente @relation(fields: [expedienteId], references: [id])
  documento  Documento? @relation(fields: [documentoId], references: [id])
  suplidos   Suplido[]
  conceptos ConceptoFactura[]

  @@unique([despachoId, numero])
  @@index([despachoId, fechaEmision(sort: Asc)])
  @@map("facturas")
}

model ConceptoFactura {
  id          String  @id @default(uuid())
  facturaId   String  @map("factura_id")
  descripcion String
  importe     Decimal @db.Decimal(12, 2)
  orden       Int     @default(0)

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("conceptos_factura")
}

model FacturaCounter {
  id         String @id @default(uuid())
  despachoId String @map("despacho_id")
  anio       Int
  ultimo     Int    @default(0)

  @@unique([despachoId, anio])
  @@map("factura_counters")
}

// ─── Suplido ──────────────────────────────────────────────────────────────────

model Suplido {
  id           String   @id @default(uuid())
  facturaId    String?  @map("factura_id")
  expedienteId String   @map("expediente_id")
  concepto     String
  importe      Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  factura    Factura?    @relation(fields: [facturaId], references: [id])
  expediente Expediente  @relation(fields: [expedienteId], references: [id])
  documentos Documento[]

  @@map("suplidos")
}

// ─── ConfiguracionFiscal ─────────────────────────────────────────────────────

model ConfiguracionFiscal {
  id               String   @id @default(uuid())
  despachoId       String   @unique @map("despacho_id")
  tipoIva          Decimal  @default(21) @map("tipo_iva") @db.Decimal(5, 2)
  tipoIrpf         Decimal  @default(15) @map("tipo_irpf") @db.Decimal(5, 2)
  nuevoProfesional Boolean  @default(false) @map("nuevo_profesional")
  nif              String?
  epigrafeCnae     String?  @map("epigrafe_cnae")

  // Datos del despacho para la factura
  titulares        String?
  direccion        String?
  iban             String?
  banco            String?
  diasPago         Int?     @default(7) @map("dias_pago")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  @@map("configuracion_fiscal")
}

// ─── Conversacion (chatbot history) ──────────────────────────────────────────

model Conversacion {
  id          String           @id @default(uuid())
  despachoId  String           @map("despacho_id")
  creadoPorId String           @map("creado_por_id")
  tipo        TipoConversacion
  titulo      String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  despacho  Despacho  @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  creadoPor Usuario   @relation(fields: [creadoPorId], references: [id])
  mensajes  Mensaje[]

  @@index([despachoId, tipo])
  @@map("conversaciones")
}

model Mensaje {
  id             String   @id @default(uuid())
  conversacionId String   @map("conversacion_id")
  role           String // 'user' | 'assistant'
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@map("mensajes")
}

// ─── JurisprudenciaBase ───────────────────────────────────────────────────────

model JurisprudenciaBase {
  id        String    @id @default(uuid())
  titulo    String
  resumen   String    @db.Text
  tribunal  String?
  fecha     DateTime?
  url       String?
  contenido String    @db.Text
  // embedding stored as JSON array (use pgvector extension for proper vector search)
  embedding Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("jurisprudencia_base")
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id        String       @id @default(uuid())
  usuarioId String?      @map("usuario_id")
  accion    TipoAuditLog
  entidad   String
  entidadId String?      @map("entidad_id")
  detalle   Json?
  ip        String?
  userAgent String?      @map("user_agent")
  createdAt DateTime     @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId])
  @@map("audit_logs")
}


// ─── Plan de uso ─────────────────────────────────────────────────────────────────

model UsageEvent {
  id         String   @id @default(uuid())
  despachoId String   @map("despacho_id")
  eventType  String   @map("event_type") // "expediente.created", "ai.call", "document.uploaded"
  quantity   Int      @default(1)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  despacho Despacho @relation(fields: [despachoId], references: [id])

  @@index([despachoId, eventType, createdAt])
  @@map("usage_events")
}

model PlanLimit {
  plan            PlanUsuario @id
  maxExpedientes  Int         @map("max_expedientes")
  maxAiCallsMonth Int         @map("max_ai_calls_month")
  maxStorageMb    Int         @map("max_storage_mb")

  @@map("plan_limits")
}

// ─── Notificaciones ─────────────────────────────────────────────────────────────────

model Notificacion {
  id                String           @id @default(uuid())
  despachoId        String           @map("despacho_id")
  usuarioId         String?          @map("usuario_id")           // destinatario (si es usuario de la plataforma)
  destinatarioEmail String           @map("destinatario_email")   // a dónde se envió realmente
  tipo              TipoNotificacion
  entidad           String
  entidadId         String?          @map("entidad_id")
  asunto            String
  enviadoEn         DateTime         @default(now()) @map("enviado_en")

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([despachoId, enviadoEn])
  @@index([tipo, entidadId])   // clave del anti-duplicados de los recordatorios
  @@map("notificaciones")
}