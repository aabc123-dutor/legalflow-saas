{
  "name": "legalflow-saas",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/**' dev",
    "build": "pnpm --filter './apps/**' build",
    "lint": "pnpm --parallel --filter './apps/**' lint",
    "typecheck": "pnpm --parallel --filter './apps/**' typecheck",
    "db:generate": "pnpm --filter database generate",
    "db:migrate": "pnpm --filter database migrate:dev",
    "db:studio": "pnpm --filter database studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
